PORT=3000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kaaf
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Set BOTH before the first run - they become the admin login for /admin
ADMIN_EMAIL=admin@kaafarchitects.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Email notifications for contact form submissions (optional - if unset,
# messages are still saved to the admin dashboard, just no email is sent)
# Option A (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_USER=Kaaf.architects@gmail.com,
#   SMTP_PASS=an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
# Option B (cPanel mailbox): SMTP_HOST=mail.kaafarchitects.com, SMTP_USER=noreply@kaafarchitects.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Kaaf.architects@gmail.com
SMTP_PASS=your-app-password
# Where notifications are delivered
NOTIFY_EMAIL=Kaaf.architects@gmail.com
# Optional: the From address (defaults to SMTP_USER)
# MAIL_FROM=noreply@kaafarchitects.com
