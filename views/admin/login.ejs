<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | KAAF</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" type="image/svg+xml" href="/assets/KAAF-Final-Logo.svg">
</head>
<body class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <img src="/assets/KAAF-Final-Logo.svg" alt="KAAF" class="login-logo">
                <h1>Admin Panel</h1>
                <p>Sign in to manage your website</p>
            </div>
            <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
            <% } %>
            <form action="/admin/login" method="POST" class="login-form">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required placeholder="admin@kaaf.design">
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required placeholder="Enter your password">
                </div>
                <button type="submit" class="btn-admin-primary">Sign In</button>
            </form>
        </div>
    </div>
</body>
</html>
