<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= typeof settings !== 'undefined' && settings.siteDescription ? settings.siteDescription : 'KAAF - Modern architecture and design solutions.' %>">
    <meta name="theme-color" content="#09221E">
    <title><%= typeof title !== 'undefined' ? title : 'KAAF' %></title>
    <% if (typeof canonicalUrl !== 'undefined') { %>
    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="KAAF">
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'KAAF' %>">
    <meta property="og:description" content="<%= typeof settings !== 'undefined' && settings.siteDescription ? settings.siteDescription : 'KAAF - Modern architecture and design solutions.' %>">
    <meta property="og:image" content="/assets/og-image.jpg">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="preload" href="/css/styles.css?v=3" as="style">
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" as="style">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css?v=3">
    <link rel="icon" type="image/svg+xml" href="/assets/KAAF-Final-Logo.svg">
</head>
<body>
    <%- body %>
    <script src="/js/main.js?v=2" defer></script>
</body>
</html>
