<%- include('../partials/header') %>

<main>
    <!-- Hero Section - Cinematic Full-Screen -->
    <section class="hero" id="home">
        <!-- Full-Screen Slider Background -->
        <div class="hero-slider-bg" id="heroSliderBg">
            <% projects.forEach(function(project, i) { %>
            <div class="slider-slide<%= i === 0 ? ' active' : '' %>" data-project="<%= i %>">
                <img src="<%= project.featuredImage %>" alt="<%= project.title %>">
            </div>
            <% }); %>
        </div>

        <!-- Overlay -->
        <div class="hero-overlay"></div>
        <div class="hero-particles" id="particles"></div>

        <!-- Centered Content -->
        <div class="hero-content">
            <div class="hero-logo">
                <img src="/assets/KAAF-Final-Logo.svg" alt="KAAF" class="hero-logo-svg">
            </div>
            <div class="hero-badge">
                <span class="badge-dot"></span>
                <span><%= settings.heroBadge %></span>
            </div>
            <p class="hero-subtitle"><%= settings.heroSubtitle %></p>
        </div>

        <!-- Project Info - Bottom Left -->
        <% if (projects.length > 0) { %>
        <div class="hero-project-info" id="heroProjectInfo">
            <span class="project-category"><%= projects[0].category %></span>
            <h3><%= projects[0].title %></h3>
            <p>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
                <%= projects[0].location %>
            </p>
        </div>
        <% } %>

        <!-- Slider Controls - Bottom Right -->
        <div class="hero-slider-controls">
            <button class="slider-btn" id="sliderPrev" aria-label="Previous project">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
            </button>
            <button class="slider-btn" id="sliderNext" aria-label="Next project">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </button>
        </div>

        <!-- Slider Dots - Bottom Center -->
        <div class="slider-dots" id="sliderDots">
            <% projects.forEach(function(project, i) { %>
            <button class="slider-dot<%= i === 0 ? ' active' : '' %>" data-slide="<%= i %>" aria-label="Go to project <%= i + 1 %>"></button>
            <% }); %>
        </div>

        <div class="hero-scroll">
            <div class="scroll-mouse">
                <div class="scroll-wheel"></div>
            </div>
            <span>Scroll to explore</span>
        </div>
    </section>

    <!-- About Section -->
    <section class="about section" id="about">
        <div class="container">
            <div class="about-content">
                <div class="about-text">
                    <div class="section-header">
                        <span class="section-tag"><%= settings.aboutTagline %></span>
                        <h2 class="section-title"><%- settings.aboutTitle %></h2>
                    </div>
                    <p class="lead"><%= settings.aboutLead %></p>
                    <p><%= settings.aboutText %></p>
                    <div class="about-stats">
                        <div class="stat">
                            <span class="stat-number" data-count="<%= settings.statsProjects %>">0</span>
                            <span class="stat-label"><%= settings.statsProjectsLabel %></span>
                        </div>
                        <div class="stat">
                            <span class="stat-number" data-count="<%= settings.statsAwards %>">0</span>
                            <span class="stat-label"><%= settings.statsAwardsLabel %></span>
                        </div>
                        <div class="stat">
                            <span class="stat-number" data-count="<%= settings.statsYears %>">0</span>
                            <span class="stat-label"><%= settings.statsYearsLabel %></span>
                        </div>
                    </div>
                </div>
                <div class="about-visual">
                    <div class="about-image-stack">
                        <div class="image-card image-card--1">
                            <img src="<%= settings.aboutImage1 %>" alt="Modern architectural building" loading="lazy">
                        </div>
                        <div class="image-card image-card--2">
                            <img src="<%= settings.aboutImage2 %>" alt="Luxury villa design" loading="lazy">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services section" id="services">
        <div class="container">
            <div class="section-header section-header--center">
                <span class="section-tag">What We Do</span>
                <h2 class="section-title">Our Services</h2>
            </div>
            <div class="services-grid">
                <% services.forEach(function(service, i) { %>
                <article class="service-card">
                    <div class="service-number"><%= String(i + 1).padStart(2, '0') %></div>
                    <div class="service-icon">
                        <%- include('../partials/service-icon', { icon: service.icon }) %>
                    </div>
                    <h3 class="service-title"><%= service.title %></h3>
                    <p class="service-desc"><%= service.description %></p>
                    <div class="service-hover"></div>
                </article>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section class="projects section" id="projects">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Portfolio</span>
                <h2 class="section-title">Featured Projects</h2>
                <p class="section-desc">Click on any project to view full details and documentation</p>
            </div>
            <div class="projects-grid">
                <% projects.forEach(function(project, i) { %>
                <a href="/projects/<%= project.slug %>" class="project-card<%= project.isFeatured ? ' project-card--featured' : '' %>">
                    <div class="project-image">
                        <img src="<%= project.featuredImage %>" alt="<%= project.title %>" loading="lazy">
                        <div class="project-overlay">
                            <span class="view-project">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="project-info">
                        <span class="project-category"><%= project.category %></span>
                        <h3 class="project-title"><%= project.title %></h3>
                        <p class="project-location">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            <%= project.location %>
                        </p>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact section" id="contact">
        <div class="container">
            <div class="contact-wrapper">
                <div class="contact-info">
                    <div class="section-header">
                        <span class="section-tag">Get in Touch</span>
                        <h2 class="section-title"><%- settings.contactTitle %></h2>
                    </div>
                    <p class="contact-desc"><%= settings.contactDesc %></p>
                    <div class="contact-details">
                        <div class="contact-item">
                            <div class="contact-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                    <polyline points="22,6 12,13 2,6"/>
                                </svg>
                            </div>
                            <div>
                                <strong>Email</strong>
                                <a href="mailto:<%= settings.email %>"><%= settings.email %></a>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                                </svg>
                            </div>
                            <div>
                                <strong>Phone</strong>
                                <a href="tel:<%= settings.phone.replace(/\s/g, '') %>"><%= settings.phone %></a>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                    <circle cx="12" cy="10" r="3"/>
                                </svg>
                            </div>
                            <div>
                                <strong>Address</strong>
                                <address><%- settings.address %></address>
                            </div>
                        </div>
                    </div>
                    <div class="social-links">
                        <a href="<%= settings.instagram %>" aria-label="Instagram" class="social-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="2" width="20" height="20" rx="5"/>
                                <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zM17.5 6.5h.01"/>
                            </svg>
                        </a>
                        <a href="<%= settings.linkedin %>" aria-label="LinkedIn" class="social-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/>
                                <circle cx="4" cy="4" r="2"/>
                            </svg>
                        </a>
                        <a href="<%= settings.behance %>" aria-label="Behance" class="social-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M22 7h-7M22 7v10c0 1-1 2-2 2h-3M15 7v10c0 1 1 2 2 2"/>
                                <path d="M2 17h5.5a3.5 3.5 0 000-7H2v7zM2 10V3h4.5a3.5 3.5 0 010 7"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <form class="contact-form" id="contactForm" action="/contact" method="POST">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name">
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required autocomplete="email" placeholder="your@email.com">
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone</label>
                        <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+20 xxx xxx xxxx">
                    </div>
                    <div class="form-group">
                        <label for="project">Project Type</label>
                        <select id="project" name="project">
                            <option value="">Select a project type</option>
                            <option value="residential">Residential</option>
                            <option value="commercial">Commercial</option>
                            <option value="interior">Interior Design</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group form-group--full">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="4" required placeholder="Tell us about your project..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-full">
                        <span>Send Message</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>

<!-- Hero Slider Data for JS -->
<script>
    window.KAAF_PROJECTS = <%- JSON.stringify(projects.map(function(p) { return { category: p.category, title: p.title, location: p.location }; })) %>;
</script>
